// Configuración de Prisma. En la Fase 4 agregaremos aquí las tablas (modelos).

// Qué código debe generar Prisma: el cliente para JavaScript
generator client {
  provider = "prisma-client-js"
}

// A qué base de datos conectarse
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//Roles del personal
enum Role {
  ADMIN
  CAJERO
  COCINA
  DOMICILIARIO
}

// Usuarios
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique //el telef identifica al cliente
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// CATALOGO
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  position    Int      @default(0) //orden en el menu y las patanllas
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  iamgeURL    String?
  available   Boolean  @default(true)
  active      Boolean  @default(true)
  isDailyMenu Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  categoryId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([active, available])
}
