// Configuración de Prisma. En la Fase 4 agregaremos aquí las tablas (modelos).

// Qué código debe generar Prisma: el cliente para JavaScript
generator client {
  provider = "prisma-client-js"
}

// A qué base de datos conectarse
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//Roles del personal
enum Role {
  ADMIN
  CAJERO
  COCINA
  DOMICILIARIO
}

/// Canal por el que LLEGÓ el pedido.
enum OrderSource {
  WHATSAPP
  VITRINA
  PUNTO_DE_VENTA
  DOMICILIO // pedido telefónico para entregar en una dirección
}

/// Cómo se ENTREGA el pedido (independiente del canal).
enum OrderType {
  EN_LOCAL
  PARA_LLEVAR
  DOMICILIO
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  EN_PREPARACION
  LISTO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  NEQUI
  DAVIPLATA
  TARJETA
  CONTRAENTREGA_EFECTIVO
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  PARCIAL
  REEMBOLSADO
}

enum TransportType {
  A_PIE
  BICICLETA
  MOTOCICLETA
}

/// OCUPADO lo pone el sistema al asignar un pedido; nunca se pone a mano.
enum DeliveryPersonStatus {
  DISPONIBLE
  OCUPADO
  INACTIVO
}

enum DeliveryStatus {
  ASIGNADO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum DiscountType {
  PORCENTAJE
  VALOR_FIJO
}

enum ScreenContentType {
  PRODUCTO
  PROMOCION
  ANUNCIO
}

enum ChatChannel {
  SIMULADOR
  WHATSAPP_CLOUD
}

// Usuarios
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersCreated    Order[]
  paymentsRecorded Payment[]
  statusChanges    OrderStatusHistory[]
  deliveryPerson   DeliveryPerson? // uno a uno: lado opcional, sin columna
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique //el telef identifica al cliente
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

// CATALOGO
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  position    Int      @default(0) //orden en el menu y las patanllas
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  iamgeURL    String?
  available   Boolean  @default(true)
  active      Boolean  @default(true)
  isDailyMenu Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  categoryId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  orderItems     OrderItem[]
  promotions     Promotion[]
  screenContents ScreenContent[]

  @@index([categoryId])
  @@index([active, available])
}

// PEDIDOS
model Order {
  id              Int            @id @default(autoincrement())
  orderNumber     Int            @unique @default(autoincrement()) // número visible: "pedido 105"
  source          OrderSource
  type            OrderType      @default(EN_LOCAL)
  status          OrderStatus    @default(PENDIENTE)
  customerId      Int? // vacío = cliente de mostrador sin datos
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  paymentMethod   PaymentMethod? // lo que el cliente ELIGIÓ (no significa que pagó)
  paymentStatus   PaymentStatus  @default(PENDIENTE)
  deliveryAddress String?
  notes           String?
  cancelReason    String?
  createdById     Int? // vacío = lo creó el bot de WhatsApp
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy     User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  delivery      Delivery?
  chatSession   ChatSession?

  @@index([status])
  @@index([source])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int? // SetNull: si algún día se borra el producto, el ítem sobrevive
  productName String // copia histórica
  unitPrice   Decimal @db.Decimal(12, 2) // copia histórica
  quantity    Int
  notes       String? // "sin cebolla"
  subtotal    Decimal @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id             Int          @id @default(autoincrement())
  orderId        Int
  previousStatus OrderStatus? // vacío en el primer registro (creación)
  newStatus      OrderStatus
  changedById    Int? // vacío = sistema o bot
  note           String?
  createdAt      DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

//PAGOS

model Payment {
  id           Int           @id @default(autoincrement())
  orderId      Int
  method       PaymentMethod
  status       PaymentStatus @default(PAGADO)
  amount       Decimal       @db.Decimal(12, 2)
  reference    String? // número de transacción de Nequi, Daviplata…
  notes        String?
  recordedById Int // quién recibió el dinero (auditoría)
  createdAt    DateTime      @default(now())

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recordedBy User  @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([method, createdAt])
}

//DOMICILIOS

model DeliveryPerson {
  id            Int                  @id @default(autoincrement())
  name          String
  phone         String               @unique
  transportType TransportType
  availability  DeliveryPersonStatus @default(DISPONIBLE)
  active        Boolean              @default(true) // false = ya no trabaja aquí
  userId        Int?                 @unique // uno a uno: su cuenta para la app
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries Delivery[]

  @@index([availability, active])
}

model Delivery {
  id               Int            @id @default(autoincrement())
  orderId          Int            @unique // uno a uno: una entrega vigente por pedido
  deliveryPersonId Int
  status           DeliveryStatus @default(ASIGNADO)
  assignedAt       DateTime       @default(now())
  pickedUpAt       DateTime?
  deliveredAt      DateTime?

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  deliveryPerson DeliveryPerson @relation(fields: [deliveryPersonId], references: [id], onDelete: Restrict)

  @@index([deliveryPersonId, status])
}

//PROMOCIONES Y PANTALLAS

model Promotion {
  id            Int          @id @default(autoincrement())
  name          String
  description   String?
  discountType  DiscountType @default(PORCENTAJE)
  discountValue Decimal      @db.Decimal(12, 2)
  imageUrl      String?
  productId     Int? // promoción ligada a un producto (opcional)
  startDate     DateTime
  endDate       DateTime
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  screenContents ScreenContent[]

  @@index([active, startDate, endDate])
}

model MenuScreen {
  id           Int      @id @default(autoincrement())
  screenNumber Int      @unique // 1 a 4
  name         String
  description  String?
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  contents ScreenContent[]
}

model ScreenContent {
  id          Int               @id @default(autoincrement())
  screenId    Int
  contentType ScreenContentType
  title       String?
  description String?
  imageUrl    String?
  productId   Int? // si es PRODUCTO: el precio y la disponibilidad se leen en vivo
  promotionId Int? // si es PROMOCION
  position    Int               @default(0)
  active      Boolean           @default(true)

  screen    MenuScreen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([screenId, position])
}

//BOT Y AJUSTES

/// Estado de una conversación del bot. El mismo motor sirve al simulador
/// y, más adelante, a WhatsApp real.
model ChatSession {
  id        String      @id @default(uuid())
  channel   ChatChannel @default(SIMULADOR)
  phone     String?
  step      String      @default("INICIO") // paso actual de la conversación
  data      Json        @default("{}") // carrito y datos capturados
  orderId   Int?        @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([phone, updatedAt])
}

//Parámetros que el administrador puede cambiar (p. ej. DELIVERY_FEE = "5000").
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
