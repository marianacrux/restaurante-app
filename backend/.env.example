PORT=4000
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/restaurante_db?schema=public"

SEED_USER_PASSWORD=CAMBIAR_CONTRASENA_DEMO

# Genere uno con: openssl rand -hex 48
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=8h

# Reporte automático cada hora en Excel.
# Ruta del archivo de la empresa (relativa a backend/ o absoluta). Para compartirlo,
# use una carpeta sincronizada con OneDrive / Google Drive, por ejemplo:
# EXCEL_REPORT_PATH=/Users/empresa/OneDrive/Reportes/reporte-ventas.xlsx
EXCEL_REPORT_PATH=reports/reporte-ventas.xlsx
# Ponga false para desactivar el reporte automático
REPORTS_ENABLED=true

# Dirección pública del frontend (para el enlace de seguimiento que envía el bot)
PUBLIC_APP_URL=http://localhost:5173
